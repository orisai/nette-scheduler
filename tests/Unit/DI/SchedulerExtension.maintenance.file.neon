extensions:
	orisai.scheduler: OriNette\Scheduler\DI\SchedulerExtension

orisai.scheduler:
	executor: process
	console:
		script: tests/Unit/DI/schedulerExtensionProcessExecutable.php

	runRegistry: Orisai\Scheduler\RunRegistry\FileRunRegistry(%tempDir%/scheduler-runs)

	maintenance:
		checker: Tests\OriNette\Scheduler\Doubles\TestMaintenanceChecker
		gracePeriodSeconds: 60

	jobs:
		0:
			expression: * * * * *
			callback: [@service, 'do']

services:
	service: Tests\OriNette\Scheduler\Doubles\TestService
