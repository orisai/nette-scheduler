extensions:
	orisai.scheduler: OriNette\Scheduler\DI\SchedulerExtension

orisai.scheduler:
	executor: process
	console:
		script: tests/Unit/DI/schedulerExtensionProcessExecutable.php

	runRegistry: Orisai\Scheduler\RunRegistry\LockPoolRunRegistry(poolSize: 5)

	maintenance:
		checker: Tests\OriNette\Scheduler\Doubles\TestMaintenanceChecker
		gracePeriodSeconds: 15

	jobs:
		0:
			expression: * * * * *
			callback: [@service, 'do']

services:
	service: Tests\OriNette\Scheduler\Doubles\TestService
	- Symfony\Component\Lock\LockFactory(Symfony\Component\Lock\Store\InMemoryStore())
